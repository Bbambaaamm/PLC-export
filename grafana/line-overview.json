    {
      "id": 60,
      "title": "Produkce · BR08 za posledních 60 minut",
      "description": "Každý bod je přírůstek čítače za předchozích 60 minut. Celkem = 05 + 10 + 15 + 20. Stavové souvislosti jsou v časově zarovnaném panelu pod grafem, aby produkční křivky zůstaly čitelné.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 17,
        "h": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(((sum by(job,instance) (increase(br08_prefix_total{job=\"${job}\",instance=\"${instance}\",prefix=~\"05|10|15|20\"}[1h]))) and on(job,instance) (increase(line_observed_seconds_total{job=\"${job}\",instance=\"${instance}\"}[1h]) >= 3420) and on(job,instance) (min_over_time(line_br_data_valid{job=\"${job}\",instance=\"${instance}\",station=\"BR08\"}[1h]) == 1)) and on(job,instance) (plc_data_valid{job=\"${job}\",instance=\"${instance}\"} == 1)) and on(job,instance) (up{job=\"${job}\",instance=\"${instance}\"} == 1)",
          "legendFormat": "Celkem",
          "instant": false,
          "range": true,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "B",
          "expr": "(((increase(br08_prefix_total{job=\"${job}\",instance=\"${instance}\",prefix=\"05\"}[1h])) and on(job,instance) (increase(line_observed_seconds_total{job=\"${job}\",instance=\"${instance}\"}[1h]) >= 3420) and on(job,instance) (min_over_time(line_br_data_valid{job=\"${job}\",instance=\"${instance}\",station=\"BR08\"}[1h]) == 1)) and on(job,instance) (plc_data_valid{job=\"${job}\",instance=\"${instance}\"} == 1)) and on(job,instance) (up{job=\"${job}\",instance=\"${instance}\"} == 1)",
          "legendFormat": "Boxy 05",
          "instant": false,
          "range": true,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "C",
          "expr": "(((increase(br08_prefix_total{job=\"${job}\",instance=\"${instance}\",prefix=\"10\"}[1h])) and on(job,instance) (increase(line_observed_seconds_total{job=\"${job}\",instance=\"${instance}\"}[1h]) >= 3420) and on(job,instance) (min_over_time(line_br_data_valid{job=\"${job}\",instance=\"${instance}\",station=\"BR08\"}[1h]) == 1)) and on(job,instance) (plc_data_valid{job=\"${job}\",instance=\"${instance}\"} == 1)) and on(job,instance) (up{job=\"${job}\",instance=\"${instance}\"} == 1)",
          "legendFormat": "Boxy 10",
          "instant": false,
          "range": true,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "D",
          "expr": "(((increase(br08_prefix_total{job=\"${job}\",instance=\"${instance}\",prefix=\"15\"}[1h])) and on(job,instance) (increase(line_observed_seconds_total{job=\"${job}\",instance=\"${instance}\"}[1h]) >= 3420) and on(job,instance) (min_over_time(line_br_data_valid{job=\"${job}\",instance=\"${instance}\",station=\"BR08\"}[1h]) == 1)) and on(job,instance) (plc_data_valid{job=\"${job}\",instance=\"${instance}\"} == 1)) and on(job,instance) (up{job=\"${job}\",instance=\"${instance}\"} == 1)",
          "legendFormat": "Boxy 15",
          "instant": false,
          "range": true,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
