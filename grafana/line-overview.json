{
  "uid": "plc-line-overview",
  "title": "Smartlog · provozní přehled",
  "schemaVersion": 39,
  "version": 5,
  "timezone": "Europe/Prague",
  "description": "Profesionální provozní přehled Smartlog linky. Overview zobrazuje pouze rozhodovací informace; detailní PLC signály jsou oddělené v diagnostice. Čekání není automaticky porucha a BR pozorování nejsou garantované fyzické průjezdy.",
  "tags": [
    "PLC",
    "DB2000",
    "Smartlog"
  ],
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Zdroj",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/^Zoo$/",
        "refresh": 1
      },
      {
        "name": "job",
        "label": "Exportér",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(plc_data_valid, job)",
        "refresh": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(plc_data_valid{job=\"${job}\"}, instance)",
        "refresh": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "history_url",
        "label": "Adresa historie",
        "type": "textbox",
        "hide": 2,
        "query": "http://EXPORTER:8000/history",
        "current": {
          "text": "http://EXPORTER:8000/history",
          "value": "http://EXPORTER:8000/history"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 2,
      "title": "Boxy dnes",
      "description": "Aktuální denní PLC čítač. Nejde o potvrzenou expedici.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((dnes_pocet_boxu{job=\"${job}\",instance=\"${instance}\"} and on(job,instance) (line_daily_box_count_valid{job=\"${job}\",instance=\"${instance}\"} == 1)) and on(job,instance) (plc_data_valid{job=\"${job}\",instance=\"${instance}\"} == 1)) and on(job,instance) (up{job=\"${job}\",instance=\"${instance}\"} == 1)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "noValue": "Bez dat",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 26
        }
      },
      "transparent": true
    },
    {
      "id": 3,
      "title": "Tempo · boxů/h",
      "description": "Přírůstky za 5 minut, pouze při nejméně 90 % pokrytí měřením.",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((rate(line_observed_box_increments_total{job=\"${job}\",instance=\"${instance}\"}[5m]) * 3600 and on(job,instance) (rate(line_observed_seconds_total{job=\"${job}\",instance=\"${instance}\"}[5m]) >= 0.9)) and on(job,instance) (plc_data_valid{job=\"${job}\",instance=\"${instance}\"} == 1)) and on(job,instance) (up{job=\"${job}\",instance=\"${instance}\"} == 1)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "noValue": "Bez dat",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 26
        }
      },
      "transparent": true
    },
    {
      "id": 5,
      "title": "BR08 · poslední hodina",
      "description": "Součet prefixů 05/10/15/20 za klouzavých 60 minut.",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(((sum by(job,instance) (increase(br08_prefix_total{job=\"${job}\",instance=\"${instance}\",prefix=~\"05|10|15|20\"}[1h]))) and on(job,instance) (increase(line_observed_seconds_total{job=\"${job}\",instance=\"${instance}\"}[1h]) >= 3420) and on(job,instance) (min_over_time(line_br_data_valid{job=\"${job}\",instance=\"${instance}\",station=\"BR08\"}[1h]) == 1)) and on(job,instance) (plc_data_valid{job=\"${job}\",instance=\"${instance}\"} == 1)) and on(job,instance) (up{job=\"${job}\",instance=\"${instance}\"} == 1)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "noValue": "Bez dat",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 26
        }
      },
      "transparent": true
    },
    {
      "id": 12,
      "title": "Aktivní čekání",
      "description": "Počet zařízení, která právě hlásí čekání.",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum by(job,instance) (line_waiting_active{job=\"${job}\",instance=\"${instance}\"} == bool 1)) and on(job,instance) (plc_data_valid{job=\"${job}\",instance=\"${instance}\"} == 1)) and on(job,instance) (up{job=\"${job}\",instance=\"${instance}\"} == 1)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "noValue": "Bez dat",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 26
        }
      },
      "transparent": true
    },
    {
      "id": 13,
      "title": "Kritické stavy",
      "description": "Materiál stop + chyba stroje + nepřipravená bezpečnost.",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum by(job,instance) ((line_machine_state{job=\"${job}\",instance=\"${instance}\"} == bool 5) + (line_machine_state{job=\"${job}\",instance=\"${instance}\"} == bool 6) + (line_machine_state{job=\"${job}\",instance=\"${instance}\"} == bool 7))) and on(job,instance) (plc_data_valid{job=\"${job}\",instance=\"${instance}\"} == 1)) and on(job,instance) (up{job=\"${job}\",instance=\"${instance}\"} == 1)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "noValue": "Bez dat",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 26
        }
      },
      "transparent": true
    },
    {
      "id": 7,
      "title": "PLC data",
      "description": "",
      "type": "stat",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"${job}\",instance=\"${instance}\"} * on(job,instance) plc_data_valid{job=\"${job}\",instance=\"${instance}\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Bez dat",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Neplatná",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Aktuální",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
