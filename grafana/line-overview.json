        {
          "refId": "E",
          "expr": "(((increase(br08_prefix_total{job=\"${job}\",instance=\"${instance}\",prefix=\"20\"}[1h])) and on(job,instance) (increase(line_observed_seconds_total{job=\"${job}\",instance=\"${instance}\"}[1h]) >= 3420) and on(job,instance) (min_over_time(line_br_data_valid{job=\"${job}\",instance=\"${instance}\",station=\"BR08\"}[1h]) == 1)) and on(job,instance) (plc_data_valid{job=\"${job}\",instance=\"${instance}\"} == 1)) and on(job,instance) (up{job=\"${job}\",instance=\"${instance}\"} == 1)",
          "legendFormat": "Boxy 20",
