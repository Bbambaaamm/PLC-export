{
  "uid": "plc-machine-detail",
  "title": "Smartlog · detail zařízení",
  "schemaVersion": 39,
  "version": 2,
  "timezone": "Europe/Prague",
  "description": "Kompaktní provozní přehled podle původního dashboardu. Čekání není automaticky porucha; BR pozorování nejsou garantované průjezdy. OEE a forecast vyžadují schválený kontrakt a směnový kalendář.",
  "tags": [
    "PLC",
    "DB2000",
    "Smartlog"
  ],
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Zdroj",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      },
      {
        "name": "job",
        "label": "Exportér",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(plc_data_valid, job)",
        "refresh": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(plc_data_valid{job=~\"${job:regex}\"}, instance)",
        "refresh": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "history_url",
        "label": "Adresa historie",
        "type": "textbox",
        "hide": 2,
        "query": "http://EXPORTER:8000/history",
        "current": {
          "text": "http://EXPORTER:8000/history",
          "value": "http://EXPORTER:8000/history"
        }
      },
      {
        "name": "station",
        "label": "Zařízení",
        "type": "custom",
        "query": "vaha,V10,V20,AKL1,AKL2,T1,T2",
        "current": {
          "text": "V10",
          "value": "V10"
        },
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Detail zařízení · ${station}",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "title": "Aktuální stav",
      "description": "",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(line_machine_state{job=~\"${job:regex}\",instance=~\"${instance:regex}\",station=~\"${station:regex}\"}) and on(job,instance) (up{job=~\"${job:regex}\",instance=~\"${instance:regex}\"} == 1)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Bez dat",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Bez platných dat",
                  "color": "gray",
                  "index": 0
                },
                "0": {
                  "text": "Bez potvrzení chodu",
                  "color": "gray",
                  "index": 1
                },
                "1": {
                  "text": "Připraveno",
                  "color": "blue",
                  "index": 2
                },
                "2": {
                  "text": "Chod potvrzen",
                  "color": "green",
                  "index": 3
                },
                "3": {
                  "text": "Čekání před zařízením",
                  "color": "yellow",
                  "index": 4
                },
                "4": {
                  "text": "Doplňte materiál",
                  "color": "orange",
                  "index": 5
                },
                "5": {
                  "text": "Materiál došel",
                  "color": "red",
                  "index": 6
                },
                "6": {
                  "text": "Chyba stroje",
                  "color": "red",
                  "index": 7
                },
                "7": {
                  "text": "Bezpečnost nepřipravena",
                  "color": "red",
                  "index": 8
                },
                "8": {
                  "text": "Průchod bez etiketování",
                  "color": "purple",
                  "index": 9
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 26
        }
      }
    },
    {
      "id": 3,
      "title": "Aktuální čekání",
      "description": "",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((line_waiting_current_seconds{job=~\"${job:regex}\",instance=~\"${instance:regex}\",station=~\"${station:regex}\"}) and on(job,instance) (plc_data_valid{job=~\"${job:regex}\",instance=~\"${instance:regex}\"} == 1)) and on(job,instance) (up{job=~\"${job:regex}\",instance=~\"${instance:regex}\"} == 1)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Bez dat",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 26
        }
      }
    },
    {
      "id": 4,
      "title": "Čekání ve výběru",
      "description": "",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(line_waiting_seconds_total{job=~\"${job:regex}\",instance=~\"${instance:regex}\",station=~\"${station:regex}\"}[${__range_s}s])",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Bez dat",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
